#!/bin/sh
#
# Rebuilds docs/ from src/ before every commit and stages the result, so the
# published site can never lag behind the sources. Install with:
#
#     ln -sf "../../claude scripts/pre-commit" .git/hooks/pre-commit
#
# Skip once with:  git commit --no-verify

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# A clone without the plaintext sources (or without .env) cannot build, and
# should still be able to commit README or config changes.
if [ ! -d src ] || [ -z "$(find src -name '*.html' -print -quit 2>/dev/null)" ]; then
    echo "pre-commit: no src/*.html here, leaving docs/ untouched"
    exit 0
fi
if [ ! -f .env ] && [ -z "$TRAVEL_PASSWORD" ]; then
    echo "pre-commit: no .env and no TRAVEL_PASSWORD, leaving docs/ untouched"
    exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: uv not found, cannot rebuild docs/" >&2
    exit 1
fi

# src/ is gitignored, so a src-only edit leaves the index empty. Git decides
# there is "nothing to commit" before it sees what this hook stages, so note
# whether anything was staged to begin with.
if git rev-parse --verify -q HEAD >/dev/null && git diff --cached --quiet; then
    had_staged=no
else
    had_staged=yes
fi

echo "pre-commit: rebuilding docs/"
uv run --quiet "claude scripts/build_site.py" >/dev/null

git add -A docs

if [ "$had_staged" = no ] && ! git diff --cached --quiet; then
    echo "pre-commit: docs/ rebuilt from src/ and staged."
    echo "pre-commit: run the same commit again to record it, or use 'claude scripts/publish'."
    exit 1
fi

# docs/ may only ever contain encrypted pages. A page dropped straight into
# docs/ instead of src/ never passes through the build, so check every one.
for page in $(git diff --cached --name-only | grep -E '^docs/.*\.html$'); do
    if ! git show ":$page" | grep -q 'type="application/octet-stream"'; then
        echo "pre-commit: $page is not encrypted." >&2
        echo "pre-commit: move it to src/ and rebuild; docs/ is generated, never edited." >&2
        exit 1
    fi
done

# Last line of defence: never let readable trip content reach a commit.
if git diff --cached --name-only | grep -qE '^src/'; then
    echo "pre-commit: refusing to commit plaintext from src/" >&2
    exit 1
fi
if git diff --cached --name-only | grep -qE '^\.env$'; then
    echo "pre-commit: refusing to commit .env" >&2
    exit 1
fi

exit 0
